# ── LLMs ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── Data Sources ───────────────────────────────────────────────────────────────
APOLLO_API_KEY=...
FIRECRAWL_API_KEY=fc-...
APIFY_TOKEN=apify_api_...

# ── Google ─────────────────────────────────────────────────────────────────────
# Paste the full service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
CLIENTS_SHEET_ID=1abc...          # "LeadGen Clients" management sheet
OUTPUTS_SHEET_ID=1xyz...          # Lead results output sheet

# ── Agent ──────────────────────────────────────────────────────────────────────
AGENT_ENV=development             # development | production
ADMIN_SECRET=                     # Protects /admin/* and webhook payload export
PUBLIC_BASE_URL=                  # Apollo phone webhook Railway URL (apollo-phone-webhook repo)
APOLLO_PHONE_WEBHOOK_SECRET=      # Same secret as webhook service on Railway
APOLLO_PHONE_WEBHOOK_URL=         # Full URL: {PUBLIC_BASE_URL}/webhooks/apollo-phone/{secret}

# ── Cost tracking ───────────────────────────────────────────────────────────────
LEAD_COST_CAP_USD=0.70            # Per-lead enrichment cap
LEAD_COST_CONSECUTIVE_LIMIT=2     # Stop after N consecutive leads over cap
APOLLO_CREDIT_USD=0.02
FIRECRAWL_PAGE_USD=0.01
LLM_PER_1K_TOKENS_USD=0.003
APIFY_MAX_LINKEDIN_POSTS=5
APIFY_SKIP_LINKEDIN_POSTS=0          # 1/true to skip person post scraping
# Default SKIP — company open jobs are optional only (APIFY_SKIP_LINKEDIN_JOBS=0 to enable)
APIFY_SKIP_LINKEDIN_JOBS=1
APIFY_LINKEDIN_JOBS_ACTOR=gtgyani206/linkedin-company-scraper
# Do NOT use afanasenko/linkedin-jobs-scraper (blocked — empty/expensive)
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi/linkedin-profile-posts
APIFY_LINKEDIN_COMPANY_ACTOR=harvestapi/linkedin-company
APIFY_LINKEDIN_PERSON_ACTOR=apimaestro/linkedin-profile-detail
# Apollo must return DM linkedin_url — no Google-search backup in pipeline.
# Set APOLLO_ALLOW_MISSING_DM_LINKEDIN=1 only for legacy/debug (email-only contactable).
APOLLO_ALLOW_MISSING_DM_LINKEDIN=0
# Batch jobs cost gate for smoke_company_jobs_batch.py (USD total for full URL batch)
APIFY_JOBS_BATCH_USD_GATE=2.0
APIFY_WEBSITE_SCRAPER_ACTOR=apify/website-content-crawler   # Firecrawl fallback
